<resources>

    <style name="Theme.TransferApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Background -->
        <item name="android:colorBackground">@color/app_background_color</item>
        <item name="colorSurface">@color/card_background_color</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- On Colors -->
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnBackground">@color/text_color_primary_light</item>
        <item name="colorOnSurface">@color/text_color_primary_light</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_color_primary_light</item>
        <item name="android:textColorSecondary">@color/text_color_secondary_light</item>

        <!-- Icon Tint -->
        <item name="iconTint">@color/icon_tint_color_light</item>

        <!-- Status Bar and Window Appearance -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Action Mode and Toolbar Styling -->
        <item name="windowActionModeOverlay">true</item>
        <item name="preferenceCategoryTitleTextColor">?android:attr/textColorPrimary</item>
        <item name="actionModeStyle">@style/CustomActionModeStyle</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
    </style>


    <!-- menu background -->
    <style name="CustomActionModeStyle" parent="Widget.AppCompat.ActionMode">
        <item name="background">?attr/colorSurfaceContainerHigh</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.App.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="srcCompat">@drawable/ic_more_vert</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="actionOverflowButtonStyle">@style/Widget.App.Overflow</item>
        <item name="homeAsUpIndicator">@drawable/ic_arrow_back</item>
        <item name="popupTheme">@style/AppTheme.PopupOverlay</item>
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Light</item>
    </style>

    <!--    control menu text colors-->
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>